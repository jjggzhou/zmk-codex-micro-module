config CODEX_MICRO
    bool "Codex Micro support"
    select ZMK_HID_INDICATORS
    select ZMK_POINTING
    select BT_GATT_AUTO_UPDATE_MTU if ZMK_BLE

if CODEX_MICRO

config CODEX_REPORT_ROUTER
    bool "Codex USB-priority protocol router"
    default y if !ZTEST
    help
      Owns Vendor Report ingress, JSON-RPC dispatch, and automatic USB-priority
      output selection. Ztests enable this explicitly when testing the router.

config CODEX_FIRMWARE_VERSION
    string "Codex compatibility firmware version"
    default "0.4.1"
    help
      Compatibility target reported by sys.version and device.status. The
      value is based on the original unit used for protocol verification.

config ZMK_KEYBOARD_NAME
    string
    default "Codex Micro"

config USB_DEVICE_VID
    default 0x303A

config USB_DEVICE_PID
    default 0x8360

config USB_DEVICE_MANUFACTURER
    default "Work Louder"

config USB_DEVICE_PRODUCT
    default "Codex Micro"

config USB_HID_DEVICE_COUNT
    int
    default 1
    range 1 1

config HID_INTERRUPT_EP_MPS
    int
    default 64
    range 64 64

config USB_HID_REPORTS
    int
    default 6
    range 6 6

config ZMK_HID_KEYBOARD_REPORT_SIZE
    int
    default 6
    range 6 6

config ZMK_HID_CONSUMER_REPORT_SIZE
    int
    default 1
    range 1 1

config BT_L2CAP_TX_MTU
    default 69
    range 69 69

config BT_BUF_ACL_RX_SIZE
    default 73
    range 73 73

config BT_BUF_ACL_TX_SIZE
    default 73
    range 73 73

endif
