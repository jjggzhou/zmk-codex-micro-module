config CODEX_MICRO
    bool "Codex Micro support"
    select ZMK_HID_INDICATORS
    select ZMK_POINTING
    select BT_GATT_AUTO_UPDATE_MTU if ZMK_BLE

if CODEX_MICRO

config CODEX_REPORT_ROUTER
    bool "Codex USB-priority protocol router"
    default y if !ZTEST
    help
      Owns Vendor Report ingress, JSON-RPC dispatch, and automatic USB-priority
      output selection. Ztests enable this explicitly when testing the router.

config CODEX_INPUT_EVENT_QUEUE_DEPTH
    int "Codex input event queue depth"
    default 16
    range 1 32
    help
      Number of validated key and encoder edges owned by the input worker.

config CODEX_TOUCH_QUEUE_DEPTH
    int "Codex touch edge queue depth"
    default 16
    range 4 32
    help
      Number of timestamped touch edges and deadline ticks that can wait for
      the serialized touch state worker. The GPIO callback never blocks.

config CODEX_ANALOG_STICK
    bool "Codex analog-stick input adapter"
    default n
    help
      Converts synchronized relative X/Y events from zmk-analog-input-driver
      into Codex radial notifications. It remains disabled until a board adds
      a codex,analog-stick Devicetree node.

if CODEX_ANALOG_STICK

config CODEX_ANALOG_QUEUE_DEPTH
    int "Codex analog sample queue depth"
    default 8
    range 1 32
    help
      Number of synchronized raw or radial samples that the input callback can
      hand to the analog worker without allocating memory.

config CODEX_ANALOG_MEANINGFUL_DELTA
    int "Default analog meaningful delta (1/10000 full scale)"
    default 100
    range 0 10000
    help
      Used when a codex,analog-stick node omits meaningful-delta. 100 means a
      radial vector movement of 0.01; zero emits every synchronized sample.

config CODEX_ANALOG_REFRESH_INTERVAL_MS
    int "Default analog refresh interval (ms)"
    default 100
    range 1 2147483647
    help
      Used when a codex,analog-stick node omits refresh-interval-ms. A held
      non-center position is re-emitted after this wrap-safe uptime interval.

endif

config CODEX_FIRMWARE_VERSION
    string "Codex compatibility firmware version"
    default "0.4.1"
    help
      Compatibility target reported by sys.version and device.status. The
      value is based on the original unit used for protocol verification.

config ZMK_KEYBOARD_NAME
    string
    default "Codex Micro"

config USB_DEVICE_VID
    default 0x303A

config USB_DEVICE_PID
    default 0x8360

config USB_DEVICE_MANUFACTURER
    default "Work Louder"

config USB_DEVICE_PRODUCT
    default "Codex Micro"

config USB_HID_DEVICE_COUNT
    int
    default 1
    range 1 1

config HID_INTERRUPT_EP_MPS
    int
    default 64
    range 64 64

config USB_HID_REPORTS
    int
    default 6
    range 6 6

config ZMK_HID_KEYBOARD_REPORT_SIZE
    int
    default 6
    range 6 6

config ZMK_HID_CONSUMER_REPORT_SIZE
    int
    default 1
    range 1 1

config BT_L2CAP_TX_MTU
    default 69
    range 69 69

config BT_BUF_ACL_RX_SIZE
    default 73
    range 73 73

config BT_BUF_ACL_TX_SIZE
    default 73
    range 73 73

endif
