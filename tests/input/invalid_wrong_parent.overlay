#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    wrong_analog_source: wrong-analog-source {
        compatible = "zmk,analog-input";
        sampling-hz = <0>;
        wrong_x: x-channel {
            io-channels = <&adc0 0>;
            mv-mid = <0>; mv-min-max = <0>; mv-deadzone = <0>;
            scale-multiplier = <1>; scale-divisor = <1>;
            report-on-change-only; evt-type = <INPUT_EV_REL>; input-code = <INPUT_REL_X>;
        };
        wrong_y: y-channel {
            io-channels = <&adc0 1>;
            mv-mid = <0>; mv-min-max = <0>; mv-deadzone = <0>;
            scale-multiplier = <1>; scale-divisor = <1>;
            report-on-change-only; evt-type = <INPUT_EV_REL>; input-code = <INPUT_REL_Y>;
        };
    };
    codex_analog_test: codex-analog-test {
        compatible = "codex,analog-stick";
        input-device = <&wrong_analog_source>;
        /* Deliberately wrong: these producer children have another parent. */
        source-x-channel = <&analog_test_x>;
        source-y-channel = <&analog_test_y>;
        center-x = <2048>; center-y = <2048>; max-x = <4095>; max-y = <4095>;
        dead-zone = <100>; meaningful-delta = <100>; refresh-interval-ms = <20>;
    };
};
